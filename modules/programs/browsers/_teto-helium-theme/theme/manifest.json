{
  "manifest_version": 3,
  "name": "Teto",
  "version": "2.3",
  "theme": {
    "images": {
      "theme_frame": "frame.png",
      "theme_frame_inactive": "frame.png",
      "theme_toolbar": "frame.png",
      "theme_ntp_background": "wallpaper.png"
    },
    "colors": {
      "frame": [0, 0, 0],
      "frame_inactive": [0, 0, 0],
      "toolbar": [0, 0, 0],
      "tab_text": [255, 133, 149],
      "tab_background_text": [255, 133, 149],
      "bookmark_text": [255, 133, 149],
      "omnibox_background": [0, 0, 0, 0.5],
      "omnibox_text": [255, 133, 149],
      "ntp_background": [56, 56, 56],
      "ntp_text": [255, 133, 149]
    },
    "properties": {
      "ntp_background_alignment": "top right",
      "ntp_background_repeat": "no-repeat"
    }
  }
}
